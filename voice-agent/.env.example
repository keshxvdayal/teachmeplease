# The voice agent only does speech: Whisper (speech-to-text) and Kokoro (text-to-speech).
# What the client says comes from the web app, so no LLM or API key is needed here.

# Apple Silicon uses MLX Whisper on the GPU; other machines use faster-whisper with WHISPER_MODEL.
MLX_WHISPER_MODEL="mlx-community/whisper-small-mlx"
WHISPER_MODEL="small"

# "kokoro" sounds much more natural; "piper" is lighter.
TTS_ENGINE="kokoro"
# Leave empty to pick a voice from the scenario's gender and language.
KOKORO_VOICE=""
KOKORO_SPEED="1.0"
# "int8" (default) synthesizes about twice as fast on CPU; "fp32" is the full-precision model.
KOKORO_MODEL="int8"
PIPER_VOICE="en_US-lessac-medium"

HOST="127.0.0.1"
PORT="7860"
# Deployed app origins allowed to start calls, comma-separated.
ALLOWED_ORIGINS=""
# JSON list of STUN/TURN servers. Add a TURN server in production, e.g.
# [{"urls":["stun:stun.l.google.com:19302"]},{"urls":["turn:turn.example.com:3478"],"username":"u","credential":"p"}]
ICE_SERVERS=""
