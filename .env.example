# ---- Required -------------------------------------------------------------
# PostgreSQL connection string.
DATABASE_URL="postgresql://USER@localhost:5432/teachmeplease"

# Gemini API key (https://aistudio.google.com/apikey). Server-side only.
# Never prefix with NEXT_PUBLIC_.
GEMINI_API_KEY=""

# Long random string used to sign anonymous-visitor cookies and hash IPs.
# Generate with: openssl rand -base64 32
SESSION_SECRET=""

# ---- Optional -------------------------------------------------------------
# Model id. Default: gemini-2.5-flash
GEMINI_MODEL="gemini-2.5-flash"

# Optional backup model, used automatically when the main model is rate limited or
# unavailable. Each Gemini model has its own free-tier quota.
GEMINI_FALLBACK_MODEL="gemini-3.5-flash-lite"

# Bearer token for /api/admin/* (waitlist export, usage stats, cleanup).
ADMIN_TOKEN=""

# Public base URL, used in metadata.
APP_URL="http://localhost:3000"

# Local Pipecat voice agent URL. Start voice-agent/server.py separately.
NEXT_PUBLIC_PIPECAT_URL="http://127.0.0.1:7860/api/offer"

# Contact address shown in the footer, privacy policy and terms.
CONTACT_EMAIL="hello@example.com"

# Usage limits (defaults in src/lib/config/limits.ts).
# LIMIT_ANON_SESSIONS_PER_DAY=3
# LIMIT_USER_SESSIONS_PER_DAY=10
# LIMIT_MESSAGES_PER_DAY=120
# LIMIT_GLOBAL_AI_REQUESTS_PER_DAY=240   # keep below your Gemini tier's daily request quota
# LIMIT_MAX_USER_MESSAGE_CHARS=600
# LIMIT_SCORING_ATTEMPTS=3

# Data retention in days (used by `npm run db:cleanup`).
# RETENTION_ANON_DAYS=30
# RETENTION_USER_DAYS=365
